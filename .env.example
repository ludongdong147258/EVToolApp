# EV Tool 环境变量模板
# 复制为 .env 并填入真实值（.env 已被 gitignore，不会提交）。
# 注意：API 基础地址不走 .env，而是编译期 dart-define：
#   flutter run --dart-define=API_BASE_URL=https://api.example.com/

# 附近充电站使用 OpenStreetMap Overpass API（无 key，无需配置）

# 智谱 AI key（充电小票 OCR 识别；缺失时拍照识别入口隐藏）
# https://open.bigmodel.cn/
ZHIPU_API_KEY=

# 装备导购商品 API 基础地址
GOODS_API_BASE=https://www.fishspotradar.cn

# RevenueCat public SDK key（Pro 订阅；appl_ 开头，非机密可提交；
# 缺失时 Pro 功能全部解锁（dev 模式）——发版前必须确认非空）
# https://app.revenuecat.com/
REVENUECAT_SDK_KEY=
